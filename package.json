{
  "name": "vault-extension-monorepo",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "build:wasm": "wasm-pack build crates/vault-core --target web --release && wasm-pack build crates/vault-importers --target web --release && wasm-pack build crates/vault-otp --target web --release && node scripts/check-wasm.cjs",
    "dev": "pnpm --filter ./apps/extension dev",
    "build": "pnpm run build:wasm && pnpm --filter ./apps/extension build",
    "test:rust": "cargo test --workspace",
    "test:extension": "vitest run",
    "test:smoke": "node scripts/smoke-extension.cjs",
    "test:data-safety": "node scripts/test-data-safety.cjs",
    "test:phase-2": "node scripts/test-phase-2.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vitest": "^5.1.0"
  }
}
